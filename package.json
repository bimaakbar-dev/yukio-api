{
  "name": "yukio-api",
  "version": "2.0.0",
  "description": "Anime scraper — fetch dari AniList/Shikimori/Kitsu, push ke yukio-data",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute yukio-ratings-db --remote --file=./migrations/0002_scrape_state.sql",
    "db:init:local": "wrangler d1 execute yukio-ratings-db --local --file=./migrations/0002_scrape_state.sql",
    "db:query": "wrangler d1 execute yukio-ratings-db --remote --command=\"SELECT * FROM scrape_state LIMIT 20\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.78.0"
  }
}