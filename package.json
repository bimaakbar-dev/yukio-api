{
  "name": "yukio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:init": "wrangler d1 execute yukio-ratings-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute yukio-ratings-db --local --file=./schema.sql",
    "db:studio": "wrangler d1 execute yukio-ratings-db --local --command=\"SELECT * FROM ratings LIMIT 50\"",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "cookie": "^1.0.2"
  }
}